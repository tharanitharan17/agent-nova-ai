# ─── LLM Provider Configuration ────────────────────────────────────────────────
# Choose between: gemini or ollama
LLM_PROVIDER=ollama

# ─── Ollama Configuration (for LLM_PROVIDER=ollama) ───────────────────────────
# Ollama server endpoint (default: http://localhost:11434)
OLLAMA_ENDPOINT=http://localhost:11434

# Ollama model to use (examples: deepseek-r1:8b, qwen2.5:7b, llama3.2:3b)
LLM_MODEL=deepseek-r1:8b

# ─── Gemini Configuration (for LLM_PROVIDER=gemini) ───────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Application Configuration ─────────────────────────────────────────────────
# APP_URL: Local development URL (used for self-referential links)
APP_URL="http://localhost:3000"

# JWT_SECRET: Use a long random value outside local development.
JWT_SECRET="replace-with-a-long-random-secret"

# PORT: Server port (default: 3000)
PORT=3000

# ─── Development Configuration ────────────────────────────────────────────────
# NODE_ENV: development or production
NODE_ENV=development



